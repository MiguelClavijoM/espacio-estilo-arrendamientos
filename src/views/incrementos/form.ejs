<%- include('../partials/header') %>
<h1><%= item.id ? 'Editar incremento' : 'Nuevo incremento' %></h1>
<form method="POST" action="<%= action %>" class="form-grid">
  <div><label>Contrato</label>
    <select name="contrato_id" required>
      <option value="">Seleccione...</option>
      <% contratos.forEach(c => { %><option value="<%= c.id %>" <%= item.contrato_id == c.id ? 'selected' : '' %>>#<%= c.id %> — <%= c.inmueble %> (<%= c.arrendatario %>)</option><% }) %>
    </select>
  </div>
  <div><label>Fecha</label><input name="fecha" type="date" value="<%= item.fecha || '' %>" required></div>
  <div><label>Tipo</label>
    <select name="tipo">
      <% ['IPC','IPC + adicional','Pactado'].forEach(t => { %><option <%= item.tipo === t ? 'selected' : '' %>><%= t %></option><% }) %>
    </select>
  </div>
  <div><label>Porcentaje (%)</label><input name="porcentaje" type="number" step="0.01" value="<%= item.porcentaje || '' %>" required></div>
  <div><label>Canon anterior</label><input name="canon_anterior" type="number" step="0.01" value="<%= item.canon_anterior || '' %>" required></div>
  <div><label>Canon nuevo</label><input name="canon_nuevo" type="number" step="0.01" value="<%= item.canon_nuevo || '' %>" required></div>
  <div><label>¿Aplicado?</label>
    <select name="aplicado">
      <option value="0" <%= !item.aplicado ? 'selected' : '' %>>Pendiente</option>
      <option value="1" <%= item.aplicado ? 'selected' : '' %>>Aplicado</option>
    </select>
  </div>
  <div style="grid-column:1/-1;margin-top:8px;">
    <button class="btn" type="submit">Guardar</button>
    <a href="/incrementos" style="margin-left:8px;">Cancelar</a>
  </div>
</form>
<%- include('../partials/footer') %>
