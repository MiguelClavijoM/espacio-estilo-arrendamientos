<%- include('../partials/header') %>
<div class="toolbar"><h1>Inmuebles</h1><a class="btn" href="/inmuebles/nuevo">+ Nuevo inmueble</a></div>
<table>
  <tr><th>ID</th><th>Dirección</th><th>Tipo</th><th>Propietario</th><th>Estado</th><th>Valor ref.</th><th>Acciones</th></tr>
  <% items.forEach(it => { %>
  <tr>
    <td><%= it.id %></td><td><%= it.direccion %></td><td><%= it.tipo %></td><td><%= it.propietario_nombre %></td>
    <td><span class="badge <%= it.estado === 'Arrendado' ? 'badge-ok' : 'badge-warn' %>"><%= it.estado %></span></td>
    <td>$<%= (it.valor_referencia||0).toLocaleString('es-CO') %></td>
    <td class="actions">
      <a class="btn btn-small" href="/inmuebles/<%= it.id %>/editar">Editar</a>
      <form class="inline" method="POST" action="/inmuebles/<%= it.id %>?_method=DELETE" onsubmit="return confirm('¿Eliminar inmueble?');">
        <button class="btn btn-small btn-danger" type="submit">Eliminar</button>
      </form>
    </td>
  </tr>
  <% }) %>
  <% if (items.length === 0) { %><tr><td colspan="7" class="empty">No hay inmuebles registrados.</td></tr><% } %>
</table>
<%- include('../partials/footer') %>
