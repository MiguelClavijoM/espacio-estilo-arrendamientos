<%- include('../partials/header') %>
<div class="toolbar"><h1>Arrendatarios</h1><a class="btn" href="/arrendatarios/nuevo">+ Nuevo arrendatario</a></div>
<table>
  <tr><th>ID</th><th>Nombre</th><th>Documento</th><th>Teléfono</th><th>Correo</th><th>Acciones</th></tr>
  <% items.forEach(it => { %>
  <tr>
    <td><%= it.id %></td><td><%= it.nombre %></td><td><%= it.documento %></td>
    <td><%= it.telefono || '' %></td><td><%= it.correo || '' %></td>
    <td class="actions">
      <a class="btn btn-small" href="/arrendatarios/<%= it.id %>/editar">Editar</a>
      <form class="inline" method="POST" action="/arrendatarios/<%= it.id %>?_method=DELETE" onsubmit="return confirm('¿Eliminar arrendatario?');">
        <button class="btn btn-small btn-danger" type="submit">Eliminar</button>
      </form>
    </td>
  </tr>
  <% }) %>
  <% if (items.length === 0) { %><tr><td colspan="6" class="empty">No hay arrendatarios registrados.</td></tr><% } %>
</table>
<%- include('../partials/footer') %>
