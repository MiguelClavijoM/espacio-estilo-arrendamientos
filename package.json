{
  "name": "espacioestilo-prototipo",
  "version": "1.0.0",
  "description": "Prototipo funcional - Sistema de informacion para gestion integral de arrendamientos - ESPACIO & ESTILO INMOBILIARIA (Node.js + Firebase Firestore)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
